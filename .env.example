# Google AI Studio key -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube Data API v3 key -> Google Cloud Console > enable "YouTube Data API v3" > Credentials > API key
# Public data only. No OAuth, no consent screen needed.
YOUTUBE_API_KEY=

# Only needed for uploading and scheduling to your own channel.
# Google Cloud Console > Credentials > Create OAuth client ID > Web application.
# Add http://localhost:8787/api/auth/callback as an authorised redirect URI, then
# configure the consent screen and add your Google account as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/callback

PORT=8787
